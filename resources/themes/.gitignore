# Ignore everything
*
*/

# Do not ignore the .gitignore file
!.gitignore

# Do not ignore the "anchor" folder and its contents
!anchor/
!anchor/**/*

# Ignore all .DS_Store files
.DS_Store
# Yambo: `!anchor/**/*` (arriba) reincluye TODO el tema y anula los patrones
# del .gitignore raiz, asi que las copias locales hay que excluirlas aqui.
anchor/**/*.bak
anchor/**/*.bak.*
anchor/**/*.pre-*
anchor/**/*.orig
anchor/**/*.rej
anchor/**/.env
anchor/**/.env.*
